# Required for the contact form (/contact) to actually send emails.
# Sign up free at https://resend.com, verify a sending domain, then set:
RESEND_API_KEY=

# Optional overrides:
# Email address that receives quote requests (defaults to the address in lib/site.ts)
CONTACT_TO_EMAIL=
# "From" address used when sending (must be on a domain verified in Resend)
CONTACT_FROM_EMAIL=
